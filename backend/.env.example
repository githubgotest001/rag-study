# 复制为 backend/.env 后按需修改。所有配置都有合理默认值，不配置也能跑通检索链路。

# ---------- 可选：接入 OpenAI 兼容 LLM（不配置则用“检索片段拼接”作为回答） ----------
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://api.openai.com/v1     # 也可以指向任何 OpenAI 兼容服务
# OPENAI_MODEL=gpt-4o-mini
# LLM_ENABLED=true                              # 设为 false 可强制走无 LLM 的抽取式回答

# ---------- 切块与检索参数 ----------
# CHUNK_SIZE=400        # 每个文本块的最大字符数
# CHUNK_OVERLAP=80      # 相邻块的重叠字符数
# TOP_K=4               # 每次检索返回的块数

# ---------- 向量化模型 ----------
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------- 其它 ----------
# SEED_ON_STARTUP=true  # 首次启动（知识库为空）时自动导入 samples/ 示例文档
# DATA_DIR=data         # 向量库与文档注册表的存放目录
